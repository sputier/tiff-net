<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8632;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS1587;CS1570;CS1572;CS1573;CS1574;CS0108</NoWarn>
    <DefineConstants>$(DefineConstants);THREAD_SAFE_LIBTIFF;FIX_JPEG_IS_OJPEG;EXPOSE_LIBTIFF;EXPOSE_LIBJPEG</DefineConstants>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="C:\data\DEV\git\tiff-net\LibTiff\**\*.cs" Exclude="C:\data\DEV\git\tiff-net\LibTiff\obj\**;C:\data\DEV\git\tiff-net\LibTiff\bin\**;C:\data\DEV\git\tiff-net\LibTiff\Properties\**" Link="LibTiff\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="C:\data\DEV\git\tiff-net\src\Eleris.TiffNet\*.cs;C:\data\DEV\git\tiff-net\src\Eleris.TiffNet\Internal\*.cs" Link="Facade\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
