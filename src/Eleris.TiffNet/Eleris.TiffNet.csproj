<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- For SkipLocalsInit only (the tables of the LZW decoder, 24 KB, are not cleared for every strip or tile): no unsafe block;
         the references of System.Runtime.CompilerServices.Unsafe are listed with their bounds in docs/design/architecture.md. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Pure managed .NET library to read and write TIFF images, made for astronomy and scientific data.</Description>
  </PropertyGroup>

  <!-- NuGet package. The version is the single source of the release: the release workflow checks that the tag matches it. -->
  <PropertyGroup>
    <PackageId>Eleris.TiffNet</PackageId>
    <Version>0.1.0</Version>
    <Authors>Sébastien Putier</Authors>
    <Copyright>Copyright (c) 2026 Sébastien Putier</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>tiff;tif;bigtiff;astronomy;astro-tiff;image;science</PackageTags>
    <PackageProjectUrl>https://github.com/sputier/tiff-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sputier/tiff-net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Checks the package (and, once a version is published, compares it with <PackageValidationBaselineVersion>). -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eleris.TiffNet.Tests" />
    <InternalsVisibleTo Include="Eleris.TiffNet.Benchmarks" />
    <InternalsVisibleTo Include="Eleris.TiffNet.Fuzz" />
  </ItemGroup>

</Project>
