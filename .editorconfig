root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{cs,md,py}]
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Tests are named as sentences (A_damaged_file_fails_with_a_TiffException).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
